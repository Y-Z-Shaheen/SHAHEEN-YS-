# ============================================================
# SHAHEEN-YS — Environment Variables Reference
# ============================================================
# Copy this file to .env for local development.
# On Railway: set these in the Railway dashboard under Variables.
# NEVER commit .env or any file containing real secret values.
# ============================================================


# ------------------------------------------------------------
# Core environment
# ------------------------------------------------------------

# "production" or "development"
SHAHEEN_YS_ENV=development


# ------------------------------------------------------------
# Server
# ------------------------------------------------------------

SHAHEEN_YS_HOST=0.0.0.0

# Port — Railway sets PORT automatically.
# For local development use any free port (e.g. 8080).
PORT=8080


# ------------------------------------------------------------
# Localisation
# ------------------------------------------------------------

SHAHEEN_YS_LANGUAGE=ar
SHAHEEN_YS_LOCALE=ar_JO
SHAHEEN_YS_TIMEZONE=Asia/Amman


# ------------------------------------------------------------
# Paths
# ------------------------------------------------------------

SHAHEEN_YS_DATA_DIR=./data
SHAHEEN_YS_DATABASE_PATH=./data/db/shaheen_ys.db
SHAHEEN_YS_PLUGIN_DIR=./data/plugins


# ------------------------------------------------------------
# Features
# ------------------------------------------------------------

SHAHEEN_YS_WEBUI_ENABLED=true
SHAHEEN_YS_TERMINAL_ENABLED=true
SHAHEEN_YS_GITHUB_ENABLED=true
SHAHEEN_YS_GITHUB_REPOSITORY=


# ------------------------------------------------------------
# Runtime
# ------------------------------------------------------------

# Maximum number of concurrent async tasks
SHAHEEN_MAX_CONCURRENT_TASKS=10

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
SHAHEEN_LOG_LEVEL=INFO

# Start processing from the latest message on startup
SHAHEEN_START_FROM_LATEST=true

# UI theme: light | dark | system
SHAHEEN_THEME=system


# ------------------------------------------------------------
# Node / Nitro (optional)
# ------------------------------------------------------------

NODE_OPTIONS=
NITRO_PRESET=


# ------------------------------------------------------------
# Security
# ------------------------------------------------------------

# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SHAHEEN_YS_SECRET_KEY=

# Admin credentials for the dashboard
SHAHEEN_YS_ADMIN_USERNAME=admin
SHAHEEN_YS_ADMIN_PASSWORD=


# ------------------------------------------------------------
# Database
# ------------------------------------------------------------

# Production (Railway PostgreSQL):
#   Set DATABASE_URL to the connection string provided by Railway.
#   Railway usually sets this automatically when you add a PostgreSQL plugin.
#   Format: postgresql://user:password@host:port/dbname
#
# Development:
#   Leave DATABASE_URL empty — the app falls back to SQLite at
#   SHAHEEN_YS_DATABASE_PATH.
DATABASE_URL=


# ------------------------------------------------------------
# AI Provider Keys
# ------------------------------------------------------------
# Each provider supports unlimited numbered keys:
#   PROVIDER_API_KEY       ← base key (index 0)
#   PROVIDER_API_KEY1      ← index 1
#   PROVIDER_API_KEY2      ← index 2
#   …
# All defined keys are discovered automatically.
# Round-robin rotation and failover are applied per-worker.
# ------------------------------------------------------------

OPENROUTER_API_KEY=
TELEGRAM_BOT_TOKEN=
TAVILY_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Additional keys per provider (unlimited — add as many as needed)
# OPENAI_API_KEY1=
# OPENAI_API_KEY2=
# OPENAI_API_KEY3=
# ANTHROPIC_API_KEY1=
# ANTHROPIC_API_KEY2=
# GROQ_API_KEY1=
# GROQ_API_KEY2=


# ------------------------------------------------------------
# Gunicorn tuning (optional)
# ------------------------------------------------------------

# WEB_CONCURRENCY=4
# GUNICORN_THREADS=2
# GUNICORN_TIMEOUT=120
# GUNICORN_GRACEFUL_TIMEOUT=30
# GUNICORN_KEEPALIVE=5
# GUNICORN_MAX_REQUESTS=1000
# GUNICORN_MAX_REQUESTS_JITTER=100


# ------------------------------------------------------------
# Connection pool tuning (optional)
# ------------------------------------------------------------

# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=300
